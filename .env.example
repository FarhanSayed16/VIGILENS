# VIGILENS — environment template (copy to .env and fill in)
# Never commit a real .env file.

# --- Runtime ---
# Python 3.10+ · Node.js 18+

# --- PostgreSQL ---
POSTGRES_USER=vigilens
POSTGRES_PASSWORD=change_me
POSTGRES_DB=vigilens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vigilens:change_me@localhost:5432/vigilens

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- API security ---
SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# MVP lecturer login (hash password in later phases; plain for scaffold only if needed)
LECTURER_USERNAME=lecturer
LECTURER_PASSWORD=change_me

# --- Uploads / media ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=2048

# --- CORS (Vite dev) ---
CORS_ORIGINS=http://localhost:5173

# --- Shared vision config ---
CONFIG_PATH=./configs/default.yaml

# --- Frontend (also usable as VITE_ vars in frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
